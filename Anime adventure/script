local function resolveIcon(name)
	if type(name) == "number" then return "rbxassetid://" .. name end
	if type(name) ~= "string" or name == "" then return nil end
	if name:sub(1, 4) == "http" then
		return nil -- external image URLs are disabled in this build
	end
	if name:find("rbxasset") then return name end
	local found = IconAssets["lucide-" .. name] or IconAssets[name]
	if found then
		queueIcon(found)
	else
		if next(IconAssets) == nil then
			if not warnedIcons[""] then
				warnedIcons[""] = true
				print("[NextUI] Icon assets unavailable; text controls remain active.")
			end
		elseif not warnedIcons[name] then
			warnedIcons[name] = true
			print("[NextUI] Unknown icon \"" .. name .. "\"")
		end
	end
	return found
end

