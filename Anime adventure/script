            local left = image.Visible and 48 or 8
            local right = valueLabel.Visible and 70 or 16
            if subtitle.Visible then
                label.Position = UDim2.new(0, left, 0, 10)
                label.Size = UDim2.new(1, -(left + right), 0, 20)
                subtitle.Position = UDim2.new(0, left, 0, 34)
                subtitle.Size = UDim2.new(1, -(left + right), 0, 16)
            else
                label.Position = UDim2.new(0, left, 0, 0)
                label.Size = UDim2.new(1, -(left + right), 1, 0)
            end
        end

        function object:Visible(value) return SHApplyVisibility(self, value) end
        function object:Destroy()
            self.scope:Destroy()
            if self.root and self.root.Parent then self.root:Destroy() end
        end
        function object:Activate() if options.onActivate then options.onActivate() end return true end
        function object:SetText(value)
            self.label.Text = tostring(value or "")
            refreshLayout()
        end
        object.SetTitle = object.SetText
        function object:SetSubtitle(value)
            self.subtitle.Text = tostring(value or "")
            self.subtitle.Visible = self.subtitle.Text ~= ""
            refreshLayout()
        end
        function object:SetValue(value)
            self.value.Text = tostring(value or "")
            self.value.Visible = true
            refreshLayout()
        end
        function object:SetImage(value, imageRectOffset, imageRectSize)
            if type(value) == "table" then
                image.Image = value.image or ""
                image.ImageRectOffset = value.imageRectOffset or Vector2.zero
                image.ImageRectSize = value.imageRectSize or Vector2.zero
            elseif type(value) == "string" then
                image.Image = value
                image.ImageRectOffset = imageRectOffset or Vector2.zero
                image.ImageRectSize = imageRectSize or Vector2.zero
            else
                image.Image = ""
            end
            image.Visible = image.Image ~= ""
            refreshLayout()
        end
        function object:SetViewport(viewportSource)
            if self.viewport and self.viewport.Parent then pcall(function() self.viewport:Destroy() end) end
            self.viewport = nil
            if typeof and typeof(viewportSource) == "Instance" and viewportSource:IsA("GuiObject") then
                local ok, clone = pcall(function() return viewportSource:Clone() end)
                if ok and clone then
                    clone.Name = "SaintHubUnitViewport"
                    pcall(function() clone.Visible = true end)
                    pcall(function() clone.BackgroundTransparency = 1 end)
                    pcall(function() clone.BorderSizePixel = 0 end)
                    pcall(function() clone.ZIndex = 2 end)
                    clone.Parent = root
                    self.viewport = clone
                end
            end
        end
        object:SetImage(options.image, options.imageRectOffset, options.imageRectSize)
        if options.subtitle ~= nil or options.subtitleKey ~= nil then
            object:SetSubtitle(options.subtitle or SHTranslate(bridge.i18n, options.subtitleKey, options.parameters))
        end
        refreshLayout()
        return object
    end

    return component
end

SHMakeSection = function(section, bridge, tab, parent, preferredSide)
    local component = SHMakeComponent(tab, bridge, nil, preferredSide)
    component.parent = parent or (tab and tab._page)
    component.root = nil
    component._defaultSection = section
    component.section = section
    return component
end

local function SHCreateBridgeUI(NextUI, appModuleLoader)
    local localeData = appModuleLoader("app/Locales")
    local Assets = {Icons = setmetatable({}, {__index = function() return "" end})}
    local UI = {}
    UI.Require = function(moduleName)
        if moduleName == "ui/Assets" then return Assets end
        if moduleName == "ui/Factory" then return {withTheme = function() return {} end} end
        if moduleName == "ui/Season" then return {} end
        if moduleName == "ui/Controls" then return {} end
        if moduleName == "ui/Keybinds" then return {} end
        if moduleName == "ui/init" then return {Version = "NextUI Bridge"} end
        return nil
    end
    UI.new = function(options)
        options = options or {}
        local i18n = SHMakeI18n(localeData, options.language or "en")
        local originalSetLanguage = i18n.SetLanguage
        i18n.SetLanguage = function(self, language)
            originalSetLanguage(self, language)
            if type(options.onLanguage) == "function" then pcall(options.onLanguage, language) end
        end
        NextUI.ReducedMotion = options.reducedMotion == true
        local win = NextUI:CreateWindow({
            Title = "AA INFINITY",
            SubTitle = "Anime Adventures · Control Center",
            Theme = PersistedSettings.theme or "Darker",
            Size = Vector2.new(1020, 660),
            MinSize = Vector2.new(760, 500),
            TabWidth = 194,
            SearchWidth = 220,
            ToggleKey = MENU_TOGGLE_KEY,
            MobileButton = "Auto",
            Search = true,
            Profile = true,
            Collapsible = true,
            Stars = false,
            Glass = false,
        })
        local bridge = {
            root = win,
            tabs = {},
            tabOrder = {}, -- ordered SaintHub tab IDs; App.Start uses this during rollback
            tabComponents = {},
            i18n = i18n,
            scope = SHScope(),
            selected = "home",
            theme = NextUI.Theme,
            themes = {},
            Closed = SHSignal(),
            destroyed = false,
            settingsNavigation = nil,
            _navHeaders = {},
        }
        function bridge:ApplyNavigationLayout()
            local sideNav = win._sideNav
            if not sideNav or not sideNav.Parent then return end
            local order = 0
            local usedHeaders, placed = {}, {}

            local function addGroup(groupId, titleKey, ids)
                local visibleTabs = {}
                for _, id in ipairs(ids or {}) do
                    local tab = self.tabs[id]
                    if tab and tab._button and tab._button.Visible and not placed[id] then
                        visibleTabs[#visibleTabs + 1] = tab
                        placed[id] = true
                    end
                end
                if #visibleTabs == 0 then return end

                order = order + 8
                local header = self._navHeaders[groupId]
                if not header or not header.Parent then
                    header = Instance.new("TextLabel")
                    header.Name = "SaintHubNavGroup_" .. groupId
                    header.Size = UDim2.new(1, -8, 0, 16)
                    header.BackgroundTransparency = 1
                    header.BorderSizePixel = 0
                    header.Font = NextUI.Theme.FontBold or Enum.Font.GothamBold
                    header.TextSize = 9
                    header.TextXAlignment = Enum.TextXAlignment.Left
                    header.TextYAlignment = Enum.TextYAlignment.Center
                    header.TextColor3 = NextUI.Theme.Sub
                    header.Parent = sideNav
                    self._navHeaders[groupId] = header
                    if NextUI._AddPaint then
                        NextUI:_AddPaint(function()
                            if header.Parent then header.TextColor3 = NextUI.Theme.Sub end
                        end, header)
                    end
                end
                header.Text = self.i18n:T(titleKey)
                header.LayoutOrder = order
                header.Visible = true
                usedHeaders[groupId] = true

                for _, tab in ipairs(visibleTabs) do
                    order = order + 1
                    tab._button.LayoutOrder = order
                end
            end

            addGroup("overview", "nav.group.overview", {"home"})
            addGroup("automation", "nav.group.automation", {"farm", "units", "macros"})
            addGroup("lobby", "nav.group.lobby", {"lobby"})

            local bottom = {}
            for _, id in ipairs(self.bottomTabs or {}) do bottom[id] = true end
            local extras = {}
            for _, id in ipairs(self.tabOrder or {}) do
                local tab = self.tabs[id]
                if tab and tab._button and tab._button.Visible and not placed[id] and not bottom[id] then
                    extras[#extras + 1] = id
                end
            end
            addGroup("tools", "nav.group.tools", extras)
            addGroup("settings", "nav.group.settings", self.bottomTabs or {})

            for groupId, header in pairs(self._navHeaders) do
                if not usedHeaders[groupId] then
                    if header and header.Parent then header:Destroy() end
                    self._navHeaders[groupId] = nil
                end
            end
        end
        bridge.scope:Connect(i18n.Changed, function()
            bridge:ApplyNavigationLayout()
        end)
        bridge.themes.selected = NextUI.ThemeName or "Darker"
        function bridge.themes:Current() return {id = NextUI.ThemeName or "Darker"} end
        function bridge.themes:Bind(instance, property, source, scope)
            local function paint()
                local value
                if type(source) == "function" then value = source(NextUI.Theme)
                elseif type(source) == "string" then value = NextUI.Theme[source]
                else value = source end
                -- A missing palette entry must never be assigned to a Color3 property.
                if value == nil and property == "BackgroundColor3" then
                    value = NextUI.Theme.Surface or NextUI.Theme.Card or NextUI.Theme.Window
                end
                if value ~= nil and instance and instance.Parent then pcall(function() instance[property] = value end) end
            end
            paint()
            if NextUI._AddPaint then NextUI:_AddPaint(paint, instance) end
            if scope and type(scope.Add) == "function" then scope:Add(function() end) end
        end
        function bridge:CreateTab(options)
            options = options or {}
            local tabId = options.id or options.key or ("tab_" .. tostring(#self.tabOrder + 1))
            if self.tabs[tabId] then self:RemoveTab(tabId) end

            local icon = options.icon
            if type(icon) == "string" and icon == "" then icon = nil end
            local tab = win:AddTab({Title = SHTranslate(self.i18n, options.key or tabId), Icon = icon})
            tab._saintId = tabId
            if options.hidden and tab._button then tab._button.Visible = false end
            self.tabs[tabId] = tab
            self.tabOrder[#self.tabOrder + 1] = tabId

            local originalSelect = tab.Select
            tab.Select = function(tabObject, view)
                local result = originalSelect(tabObject, view)
                if view and view._saintPageId then self.selected = view._saintPageId else self.selected = tabId end
                return result
            end
            local component = SHMakeComponent(tab, self, nil)
            self.tabComponents[tabId] = component
            if type(options.build) == "function" then options.build(component) end
            return component
        end
        function bridge:SelectTab(id)
            local tab = self.tabs[id]
            if not tab then return false end
            if tab._parent then tab:Select() else tab:Select() end
            self.selected = id
            return true
        end
        function bridge:SetTabOrder(ids)
            local orderedTabs, orderedIds, seen = {}, {}, {}
            for _, id in ipairs(type(ids) == "table" and ids or {}) do
                local tab = self.tabs[id]
                if tab and not seen[id] then
                    orderedTabs[#orderedTabs + 1] = tab
                    orderedIds[#orderedIds + 1] = id
                    seen[id] = true
                end
            end
            for _, tab in ipairs(win.Tabs or {}) do
                local id = tab._saintId
                if id ~= nil and not seen[id] then
                    orderedTabs[#orderedTabs + 1] = tab
                    orderedIds[#orderedIds + 1] = id
                    seen[id] = true
                end
            end
            win.Tabs = orderedTabs
            self.tabOrder = orderedIds
            for index, tab in ipairs(orderedTabs) do
                if tab._button then tab._button.LayoutOrder = index end
                if tab._page then tab._page.LayoutOrder = index end
            end
        end
        function bridge:SetBottomTabs(ids)
            self.bottomTabs = ids or {}
            self:ApplyNavigationLayout()
        end
        function bridge:SetSettingsTab(id) self.settingsTab = id end
        function bridge:CreateThemeTab(options)
            options = options or {}
            return self:CreateTab({id = options.id or "themes", key = options.key or "tab.themes", hidden = options.hidden, build = function(component)
                local section = component:Section({title = "settings.themes", side = "Full"})
                section:Dropdown({key = "settings.theme", value = NextUI.ThemeName or "Darker", items = (function()
                    local list = {}
                    for _, theme in ipairs(NextUI.ThemeOrder or {"Darker", "Dark", "Light"}) do list[#list + 1] = {value = theme, label = theme} end
                    return list
                end)(), onChanged = function(theme) NextUI:SetTheme(theme); bridge.themes.selected = theme end})
            end})
        end
        function bridge:CreateKeybindTab(options)
            options = options or {}
            return self:CreateTab({id = options.id or "binds", key = options.key or "settings.keybinds", hidden = options.hidden, build = function(component)
                local section = component:Section({title = "settings.keybinds", side = "Full"})
                section:Label({key = "settings.menuKeyHint"})
                -- AddKeybind belongs to the section widget, not the raw NextUI tab.
                section.section:AddKeybind({Title = "Menu Toggle", Default = MENU_TOGGLE_KEY, MenuKey = true})
            end})
        end
        function bridge:Copy(text)
            if type(options.clipboard) == "function" then return options.clipboard(tostring(text or "")) end
            local clipboard = (getgenv and getgenv()) or _G
            local copyFn = clipboard and (clipboard.setclipboard or clipboard.to_clipboard or clipboard.writeclipboard)
            if type(copyFn) == "function" then
                local ok, result = pcall(copyFn, tostring(text or ""))
                return ok and result ~= false
            end
            return false
        end
        function bridge:Notify(title, content, kind, duration, parameters)
            local titleText = SHTranslate(self.i18n, title, parameters)
            local contentText = SHTranslate(self.i18n, content, parameters)
            NextUI:Notify({Title = titleText, Content = contentText, Duration = duration or 4, Type = kind or "info"})
        end
        function bridge:ShowLoading(_options)
            local object = {progress = 0, finished = false}
            function object:SetProgress(value, _key) self.progress = value end
            function object:Finish() self.finished = true end
            return object
        end
        function bridge:SetReducedMotion(value) NextUI.ReducedMotion = value == true end
        function bridge:RemoveTab(id)
            local tab = self.tabs[id]
            if not tab then return false end

            -- Remove any nested sub-tabs too; their content pages are siblings in NextUI.
            local function destroyTab(tabObject)
                if tabObject._subs then
                    for _, subTab in ipairs(tabObject._subs) do destroyTab(subTab) end
                    table.clear(tabObject._subs)
                end
                if tabObject._button then pcall(function() tabObject._button:Destroy() end) end
                if tabObject._page then pcall(function() tabObject._page:Destroy() end) end
            end
            destroyTab(tab)

            for index = #win.Tabs, 1, -1 do
                if win.Tabs[index] == tab then table.remove(win.Tabs, index) end
            end
            self.tabs[id] = nil
            self.tabComponents[id] = nil
            for index = #self.tabOrder, 1, -1 do
                if self.tabOrder[index] == id then table.remove(self.tabOrder, index) end
            end
            if self.selected == id then
                self.selected = self.tabOrder[1] or "home"
            end
            return true
        end
        function bridge:Dialog(options) return win:Dialog(options or {}) end
        function bridge:Destroy()
            if self.destroyed then return end
            self.destroyed = true
            self.Closed:Fire()
            self.scope:Destroy()
            self.Closed:Destroy()
            NextUI:Destroy()
        end
        return bridge
    end
    return UI
end

