-- Compatibility layer: SaintHub page API -> embedded NextUI controls.
-- This file is source material for the integrated controller, not a standalone loader.
local function SHSignal()
    local signal = {_listeners = {}}
    function signal:Connect(callback)
        local connection = {Connected = true}
        function connection:Disconnect()
            if not self.Connected then return end
            self.Connected = false
        end
        connection._callback = callback
        self._listeners[#self._listeners + 1] = connection
        return connection
    end
    function signal:Fire(...)
        if self._destroyed then return end
        self._queue = self._queue or {}
        self._queueTail = (self._queueTail or 0) + 1
        self._queue[self._queueTail] = table.pack(...)
        if self._firing then return end
        self._firing = true
        local head, processed, limit = 1, 0, 256
        while not self._destroyed and head <= self._queueTail do
            processed = processed + 1
            if processed > limit then break end
            local args = self._queue[head]
            self._queue[head] = nil
            head = head + 1
            for _, connection in ipairs(table.clone(self._listeners)) do
                if self._destroyed then break end
                if connection.Connected then
                    local ok, err = pcall(connection._callback, table.unpack(args, 1, args.n))
                    if not ok then pcall(warn, "[AA Infinity/SaintHub signal] " .. tostring(err)) end
                end
            end
        end
        local remaining = math.max(0, self._queueTail - head + 1)
        self._queue = {}
        self._queueTail = 0
        self._firing = false
        if remaining > 0 then pcall(warn, "[AA Infinity/SaintHub signal] event loop limit reached; dropped: " .. tostring(remaining)) end
    end
    function signal:Destroy()
        if self._destroyed then return end
        self._destroyed = true
        for _, connection in ipairs(self._listeners) do connection:Disconnect() end
        table.clear(self._listeners)
        self._queue = {}
        self._queueTail = 0
    end
    return signal
end

-- Scope compatibility layer. It mirrors the SaintHub core Scope contract:
-- Add/Connect return both the resource and its removable id, Child creates a
-- parent-owned scope, and Remove/Destroy release resources exactly once.
local function SHScope(errorHandler)
    local scope = {
        alive = true,
        resources = {},
        items = nil,
        serial = 0,
        errorHandler = type(errorHandler) == "function" and errorHandler or nil,
        _parent = nil,
        _parentId = nil,
    }
    scope.items = scope.resources -- backwards-compatible alias for older bridge code

    local function dispose(item)
        if item == nil then return end
        local kind = type(item)
        local runtimeType = nil
        if type(typeof) == "function" then
            local ok, result = pcall(typeof, item)
            if ok then runtimeType = result end
        end

        if runtimeType == "RBXScriptConnection" then
            item:Disconnect()
        elseif runtimeType == "Instance" then
            item:Destroy()
        elseif runtimeType == "thread" then
            local running = coroutine.running()
            if item ~= running and coroutine.status(item) ~= "dead" then
                task.cancel(item)
            end
        elseif kind == "function" then
            item()
        elseif kind == "table" then
            if type(item.Disconnect) == "function" then
                item:Disconnect()
            elseif type(item.Destroy) == "function" then
                item:Destroy()
            elseif type(item.Cancel) == "function" then
                item:Cancel()
            end
        end
    end

    function scope:SetErrorHandler(callback)
        self.errorHandler = type(callback) == "function" and callback or nil
        return self
    end

    function scope:_Report(kind, err)
        if self._reporting then return end
        if self._reportPending then
            self._reportSuppressed = (self._reportSuppressed or 0) + 1
            return
        end
        self._reportPending = true
        local handler = self.errorHandler
        pcall(warn, "[AA Infinity/SaintHub scope " .. tostring(kind) .. "] " .. tostring(err))
        local function deliver()
            self._reportPending = false
            self._reporting = true
            if handler then
                local ok, handlerError = pcall(handler, kind, err)
                if not ok then pcall(warn, "[AA Infinity/SaintHub scope handler] " .. tostring(handlerError)) end
            end
            self._reporting = false
            local suppressed = self._reportSuppressed or 0
            self._reportSuppressed = 0
            if suppressed > 0 then
                pcall(warn, "[AA Infinity/SaintHub scope] suppressed repeated callback errors: " .. tostring(suppressed))
            end
        end
        local scheduled = false
        if task and type(task.defer) == "function" then scheduled = pcall(task.defer, deliver) end
        if not scheduled then deliver() end
    end

    function scope:Add(item)
        if item == nil then return nil, nil end
        if not self.alive then
            local ok, err = pcall(dispose, item)
            if not ok then self:_Report("cleanup", err) end
            return item, nil
        end
        self.serial = self.serial + 1
        local id = self.serial
        self.resources[id] = item
        return item, id
    end

    function scope:Remove(id, cleanup)
        if id == nil then return nil end
        local item = self.resources[id]
        self.resources[id] = nil
        if cleanup and item ~= nil then
            local ok, err = pcall(dispose, item)
            if not ok then self:_Report("cleanup", err) end
        end
        return item
    end

    function scope:Connect(signal, callback)
        if not self.alive or not signal or type(signal.Connect) ~= "function" then
            return nil, nil
        end
        local connection = signal:Connect(function(...)
            if not self.alive then return end
            local ok, err = pcall(callback, ...)
            if not ok then self:_Report("callback", err) end
        end)
        return self:Add(connection)
    end

    function scope:Child()
        local child = SHScope(self.errorHandler)
        if not self.alive then
            child:Destroy()
            return child, nil
        end
        local _, id = self:Add(child)
        child._parent = self
        child._parentId = id
        child:Add(function()
            local parent = child._parent
            local parentId = child._parentId
            child._parent = nil
            child._parentId = nil
            if parent and parentId then parent:Remove(parentId, false) end
        end)
        return child, id
    end

    function scope:Delay(seconds, callback, ...)
        if not self.alive then return nil, nil end
        local args = table.pack(...)
        local resourceId
        local thread = task.delay(math.max(0, tonumber(seconds) or 0), function()
            if self.alive then
                local ok, err = pcall(callback, table.unpack(args, 1, args.n))
                if not ok then self:_Report("task", err) end
            end
            if resourceId then self:Remove(resourceId, false) end
        end)
        local _, id = self:Add(thread)
        resourceId = id
        return thread, id
    end

    function scope:Spawn(callback, ...)
        return self:Delay(0, callback, ...)
    end

    function scope:Destroy()
        if not self.alive then return end
        self.alive = false
        local resources = self.resources
        self.resources = {}
        self.items = self.resources
        for id = self.serial, 1, -1 do
            local item = resources[id]
            if item ~= nil then
                local ok, err = pcall(dispose, item)
                if not ok then self:_Report("cleanup", err) end
            end
        end
        self.serial = 0
    end

    return scope
end

local function SHTranslate(i18n, key, parameters)
    if key == nil then return "" end
    if type(key) ~= "string" then return tostring(key) end
    local result = i18n and i18n:T(key, parameters) or key
    if type(result) ~= "string" then result = tostring(result) end
    return result
end

local function SHWidgetScope()
    return SHScope()
end

local function SHSetEnabled(control, enabled)
    if control and type(control.SetLocked) == "function" then
        control:SetLocked(not (enabled == true))
    end
end

local function SHApplyVisibility(target, value)
    if target == nil then return false end
    local visible = value == true

    local function setGui(candidate)
        if candidate == nil or type(typeof) ~= "function" then return false end
        local ok, kind = pcall(typeof, candidate)
        if not ok or kind ~= "Instance" then return false end
        local isGui, gui = pcall(function() return candidate:IsA("GuiObject") end)
        if not isGui or not gui then return false end
        candidate.Visible = visible
        return true
    end

    if setGui(target) then return true end

    -- NextUI widgets and bridge controls expose different root-field names.
    local fields = {"root", "frame", "container", "holder", "label", "body"}
    for _, field in ipairs(fields) do
        local candidate = target[field]
        if setGui(candidate) then return true end
        if type(candidate) == "table" then
            for _, nestedField in ipairs({"root", "frame", "container", "holder", "label"}) do
                if setGui(candidate[nestedField]) then return true end
            end
            if type(candidate.SetVisible) == "function" then
                local ok = pcall(candidate.SetVisible, candidate, visible)
                if ok then return true end
            end
        end
    end
    return false
end
local function SHControlObject(control, i18n, key, scope, options)
    control = control or {}
    control.scope = scope or SHWidgetScope()
    control.options = options or control.options or {key = key}
    if control.SetEnabled == nil then
        control.SetEnabled = function(self, enabled) SHSetEnabled(self, enabled) end
    end
    if control.Visible == nil then
        control.Visible = function(self, value) return SHApplyVisibility(self, value) end
    end
    if control.SetText == nil and control.Set ~= nil then
        control.SetText = function(self, value) self:Set(SHTranslate(i18n, value), true) end
    end
    if control.SetValue == nil and control.Set ~= nil then
        control.SetValue = function(self, value, silent) self:Set(value, silent) end
    end
    if control.GetValue == nil and control.Get ~= nil then
        control.GetValue = function(self) return self:Get() end
    end
    if control.SetItems == nil and control.Refresh ~= nil then
        control.SetItems = function(self, items) self:Refresh(items) end
    end
    return control
end

local function SHMakeI18n(localeData, initialLanguage)
    if type(localeData) ~= "table" then localeData = {} end
    -- Keep the language selector usable even when no external locale pack was supplied.
    if type(localeData.en) ~= "table" then localeData.en = {name = "English", strings = {}} end
    if type(localeData.ru) ~= "table" then localeData.ru = {name = "Русский", strings = {}} end
    local i18n = {language = initialLanguage or "en", Changed = SHSignal()}
    local navigationTitles = {
        ["tab.home"] = {en = "Overview", ru = "Обзор", de = "Übersicht"},
        ["workflow.game"] = {en = "Auto Farm", ru = "Автофарм", de = "Auto-Farm"},
        ["workflow.team"] = {en = "Team Setup", ru = "Команда и юниты", de = "Team-Setup"},
        ["tab.macros"] = {en = "Macro Editor", ru = "Редактор макросов", de = "Makro-Editor"},
        ["tab.lobby"] = {en = "Lobby Tools", ru = "Инструменты лобби", de = "Lobby-Tools"},
        ["tab.settings"] = {en = "Settings", ru = "Настройки", de = "Einstellungen"},
    }
    local function currentStrings()
        local language = localeData[i18n.language] or localeData.en or {}
        return language.strings or {}
    end
    function i18n:T(key, parameters)
        if type(key) ~= "string" then return tostring(key or "") end
        local strings = currentStrings()
        local navTitle = navigationTitles[key]
        local value = (navTitle and navTitle[i18n.language]) or strings[key]
        if value == nil then value = (localeData.en and localeData.en.strings and localeData.en.strings[key]) end
        if value == nil then
            local custom = {
                ["settings.externalLinksDisabled"] = "External community links and webhooks are removed.",
                ["codes.externalListRemoved"] = "Automatic web code lists are removed; manual code redemption remains available.",
                ["notifications.externalIntegrationsRemoved"] = "Discord, Telegram and webhook delivery were removed. No external notification endpoints are configured.",
                ["settings.serverHopRemoved"] = "Server Hop is disabled because its external server-list API was removed.",
                ["settings.teleportRemoved"] = "Teleport re-execution is disabled because it downloaded the script externally.",
                ["settings.themes"] = "Theme",
                ["settings.keybinds"] = "Keybinds",
                ["settings.menuKeyHint"] = "Use this control to change the menu toggle key.",
                ["ui.typeHere"] = "Type here",
                ["nav.group.overview"] = "OVERVIEW",
                ["nav.group.automation"] = "AUTOMATION",
                ["nav.group.lobby"] = "LOBBY",
                ["nav.group.tools"] = "MORE TOOLS",
                ["nav.group.settings"] = "PREFERENCES",
            }
            local customRu = {
                ["settings.externalLinksDisabled"] = "Внешние ссылки, вебхуки и интеграции удалены.",
                ["codes.externalListRemoved"] = "Автоматические списки кодов из сети отключены; ручной ввод кодов остался.",
                ["notifications.externalIntegrationsRemoved"] = "Отправка через Discord, Telegram и вебхуки отключена. Внешние адреса не настроены.",
                ["settings.serverHopRemoved"] = "Server Hop отключён: его внешний API списка серверов удалён.",
                ["settings.teleportRemoved"] = "Повторный запуск скрипта после телепорта отключён: он загружал внешний скрипт.",
                ["settings.themes"] = "Тема",
                ["settings.keybinds"] = "Клавиши",
                ["settings.menuKeyHint"] = "Здесь можно изменить клавишу открытия меню.",
                ["ui.typeHere"] = "Введите здесь",
                ["nav.group.overview"] = "ОБЗОР",
                ["nav.group.automation"] = "АВТОМАТИЗАЦИЯ",
                ["nav.group.lobby"] = "ЛОББИ",
                ["nav.group.tools"] = "ДРУГИЕ ИНСТРУМЕНТЫ",
                ["nav.group.settings"] = "НАСТРОЙКИ",
            }
            local customDe = {
                ["nav.group.overview"] = "ÜBERSICHT",
                ["nav.group.automation"] = "AUTOMATISIERUNG",
                ["nav.group.lobby"] = "LOBBY",
                ["nav.group.tools"] = "WEITERE TOOLS",
                ["nav.group.settings"] = "EINSTELLUNGEN",
            }
            value = (i18n.language == "ru" and customRu[key]) or (i18n.language == "de" and customDe[key]) or custom[key] or key
        end
        value = tostring(value)
        -- SaintHub accepts either a parameter table or a lazy parameter provider.
        -- Some labels pass parameters = function() return {count = ...} end.
        if type(parameters) == "function" then
            local ok, resolved = pcall(parameters)
            parameters = (ok and type(resolved) == "table") and resolved or {}
        elseif type(parameters) ~= "table" then
            parameters = {}
        end
        for name, replacement in pairs(parameters) do
            value = value:gsub("{" .. tostring(name) .. "}", tostring(replacement))
        end
        return value
    end
    function i18n:Has(key)
        if type(key) ~= "string" then return false end
        -- T() returns the key unchanged when no translation exists.
        return self:T(key) ~= key
    end
    function i18n:Options()
        local options = {}
        for code, language in pairs(localeData) do
            if type(code) == "string" and type(language) == "table" then
                options[#options + 1] = {
                    value = code,
                    label = type(language.name) == "string" and language.name ~= "" and language.name or code,
                }
            end
        end
        table.sort(options, function(a, b) return a.value < b.value end)
        return options
    end
    function i18n:SetLanguage(language)
        if type(language) ~= "string" or not localeData[language] or language == self.language then return false end
        self.language = language
        self.Changed:Fire(language)
        return true
    end
    return i18n
end

local function SHMapItems(items, i18n)
    local values, valueByLabel, labelByValue = {}, {}, {}
    for _, item in ipairs(items or {}) do
        local value, label
        if type(item) == "table" then
            value = item.value
            label = item.label or (item.key and SHTranslate(i18n, item.key, item.parameters)) or tostring(value or "")
        else
            value, label = item, tostring(item)
        end
        if value ~= nil then
            label = tostring(label)
            values[#values + 1] = label
            valueByLabel[label] = value
            labelByValue[value] = label
        end
    end
    return values, valueByLabel, labelByValue
end

local SHMakeSection
local function SHMakeComponent(tab, bridge, parentFrame, preferredSide)
    local component = {
        tab = tab,
        bridge = bridge,
        parent = parentFrame or (tab and tab._page),
        root = parentFrame,
        scope = SHScope(),
        Create = nil,
        _defaultSection = nil,
        _preferredSide = preferredSide or "Full",
    }
    component.Create = component

    local function getDefaultSection(self)
        if not self._defaultSection then
            local customParent = self.root or self.parent or self.tab._page
            local previousParent = self.tab._customParent
            self.tab._customParent = customParent ~= self.tab._page and customParent or nil
            self._defaultSection = self.tab:AddSection({Side = self._preferredSide})
            self.tab._customParent = previousParent
        end
        return self._defaultSection
    end

    function component:Section(options)
        options = options or {}
        local title = options.title or options.Title or options.key
        local customParent = self.root or self.parent or self.tab._page
        local previousParent = self.tab._customParent
        self.tab._customParent = customParent ~= self.tab._page and customParent or nil
        local section = self.tab:AddSection({
            Title = title and SHTranslate(self.bridge.i18n, title, options.parameters),
            Side = options.side or options.Side or self._preferredSide,
            Icon = options.icon or options.Icon,
            Collapsible = options.collapsible == true or options.Collapsible == true,
            Badge = options.badge or options.Badge,
        })
        self.tab._customParent = previousParent
        return SHMakeSection(section, self.bridge, self.tab, customParent, self._preferredSide)
    end

    function component:Group(options)
        options = options or {}
        local section = self:Section({
            title = options.key or options.title or options.Title,
            side = options.side or self._preferredSide,
            icon = options.image or options.icon,
            collapsible = options.collapsible ~= false,
        })
        local group = {Create = section, scope = section.scope, parent = section.parent}
        function group:Visible(value) section:Visible(value) end
        return group
    end

    function component:Frame(options)
        options = options or {}
        local parent = self.root or self.parent or (self.tab and self.tab._page)
        local frame = Instance.new("Frame")
        frame.Name = tostring(options.id or "SaintHubFrame")
        frame.Size = UDim2.new(1, 0, 0, 0)
        frame.AutomaticSize = Enum.AutomaticSize.Y
        frame.BackgroundTransparency = 1
        frame.BorderSizePixel = 0
        frame.LayoutOrder = 100 + (#(self.tab and self.tab._sections or {}) or 0)
        frame.Parent = parent
        local layout = Instance.new("UIListLayout")
        layout.SortOrder = Enum.SortOrder.LayoutOrder
        layout.Padding = UDim.new(0, 8)
        layout.Parent = frame
        local child = SHMakeComponent(self.tab, self.bridge, frame, self._preferredSide)
        child.root = frame
        child.parent = parent
        child._frameOptions = options
        return child
    end

    function component:Columns(options)
        options = options or {}
        local count = math.max(1, math.min(4, tonumber(options.columns) or 2))
        local columns = {}
        for index = 1, count do
            local side = count == 1 and self._preferredSide or (index % 2 == 1 and "Left" or "Right")
            columns[index] = SHMakeComponent(self.tab, self.bridge, self.root, side)
            columns[index].parent = self.root or self.parent or self.tab._page
        end
        return {Columns = columns}
    end

    function component:Pages(options)
        options = options or {}
        local rootTab = self.tab
        while rootTab and rootTab._parent do rootTab = rootTab._parent end
        rootTab = rootTab or self.tab
        assert(rootTab and type(rootTab.AddSubTab) == "function", "SaintHub Pages needs a root NextUI tab")
        rootTab._saintPageCallbacks = rootTab._saintPageCallbacks or {}
        if not rootTab._saintSelectWrapped then
            local originalSelect = rootTab.Select
            rootTab.Select = function(parentTab, view)
                local result = originalSelect(parentTab, view)
                local pageId = view and view._saintPageId
                if pageId then
                    bridge.selected = pageId
                    for _, callback in ipairs(parentTab._saintPageCallbacks or {}) do
                        if callback.map[pageId] and callback.onChanged and not callback.suppress then
                            pcall(callback.onChanged, pageId)
                        end
                    end
                else
                    bridge.selected = parentTab._saintId
                end
                return result
            end
            rootTab._saintSelectWrapped = true
        end
        local pages, map = {}, {}
        local callbackMap = {}
        for _, pageInfo in ipairs(options.pages or {}) do
            local childTab = rootTab:AddSubTab({Title = SHTranslate(bridge.i18n, pageInfo.key, pageInfo.parameters)}, pageInfo.image)
            childTab._saintPageId = pageInfo.id
            map[pageInfo.id] = childTab
            pages[pageInfo.id] = {Create = SHMakeComponent(childTab, bridge, nil, self._preferredSide), tab = childTab}
            callbackMap[pageInfo.id] = true
        end
        local callbackRecord = {map = callbackMap, onChanged = options.onChanged, suppress = false}
        rootTab._saintPageCallbacks[#rootTab._saintPageCallbacks + 1] = callbackRecord
        local pagesObject = {pages = pages}
        function pagesObject:Select(id, silent)
            local target = map[id]
            if not target then return false end
            if silent then
                callbackRecord.suppress = true
                rootTab:Select(target)
                callbackRecord.suppress = false
            else
                rootTab:Select(target)
            end
            bridge.selected = id
            return true
        end
        if options.selected and map[options.selected] then
            pagesObject:Select(options.selected, true)
        elseif options.pages and options.pages[1] then
            pagesObject:Select(options.pages[1].id, true)
        end
        return pagesObject
    end

    function component:Visible(value)
        if self.section and self.section.Body and self.section.Body.Parent then
            self.section.Body.Parent.Visible = value == true
        elseif self.root then
            self.root.Visible = value == true
        elseif self.parent then
            self.parent.Visible = value == true
        end
    end

    function component:Label(options)
        options = options or {}
        local section = getDefaultSection(self)
        local text = SHTranslate(self.bridge.i18n, options.key or options.text or options.Text, options.parameters)
        local label = section:AddLabel(text)
        local labelRoot = label.label or label
        local object = {scope = SHScope(), label = labelRoot, root = labelRoot, bridge = self.bridge, options = options}
        function object:Set(value) label:Set(SHTranslate(self.bridge.i18n, value)) end
        function object:SetText(value) label:Set(SHTranslate(self.bridge.i18n, value)) end
        function object:Visible(value) return SHApplyVisibility(self, value) end
        function object:Destroy()
            self.scope:Destroy()
            if self.root and self.root.Parent then self.root:Destroy() end
        end
        object.scope:Add(function()
            if object.root and object.root.Parent then object.root:Destroy() end
        end)
        return object
    end

    function component:Badge(options)
        options = options or {}
        local section = getDefaultSection(self)
        local initialText = tostring(options.text or options.Text or "")
        local paragraph = section:AddParagraph({Title = "", Content = initialText})
        -- Keep label as the real Roblox TextLabel. SaintHub pages assign
        -- label.Text directly during refresh; no proxy/metamethod is needed.
        local badgeLabel = paragraph.body or paragraph.label
        local object = {scope = SHScope(), root = paragraph.root or paragraph.frame, label = badgeLabel, options = options}
        function object:Visible(value) return SHApplyVisibility(self, value) end
        function object:Destroy()
            self.scope:Destroy()
            if self.root and self.root.Parent then self.root:Destroy() end
        end
        function object:SetText(value)
            value = tostring(value or "")
            if self.label then self.label.Text = value else paragraph:Set("", value) end
        end
        function object:Set(value) self:SetText(value) end
        return object
    end

    function component:Button(options)
        options = options or {}
        local section = getDefaultSection(self)
        local control = section:AddButton({
            Title = SHTranslate(self.bridge.i18n, options.key or options.title or options.Title, options.parameters),
            Description = options.description and SHTranslate(self.bridge.i18n, options.description, options.parameters) or "",
            Callback = options.onChanged or options.callback or options.Callback,
            Hold = options.hold,
            Loading = options.loading,
        })
        return SHControlObject(control, self.bridge.i18n, options.key, SHWidgetScope(), options)
    end

    function component:Toggle(options)
        options = options or {}
        local section = getDefaultSection(self)
        local control = section:AddToggle({
            Title = SHTranslate(self.bridge.i18n, options.key or options.title or options.Title, options.parameters),
            Description = options.description and SHTranslate(self.bridge.i18n, options.description, options.parameters) or "",
            Default = options.value == true or options.default == true,
            Callback = options.onChanged or options.callback or options.Callback,
            Keybind = options.keybind,
            KeyMode = options.keyMode,
        })
        return SHControlObject(control, self.bridge.i18n, options.key, SHWidgetScope(), options)
    end

    function component:Dropdown(options)
        options = options or {}
        local section = getDefaultSection(self)
        local values, valueByLabel, labelByValue = SHMapItems(options.items or options.Values, self.bridge.i18n)
        local default = labelByValue[options.value] or labelByValue[options.default] or values[1]
        local control = section:AddDropdown({
            Title = SHTranslate(self.bridge.i18n, options.key or options.title or options.Title, options.parameters),
            Description = options.description and SHTranslate(self.bridge.i18n, options.description, options.parameters) or "",
            Values = values,
            Default = default,
            Search = #values >= 8,
            Multi = options.multi == true,
            Callback = function(label)
                local value = valueByLabel[label]
                if value == nil then value = label end
                if options.onChanged then options.onChanged(value) elseif options.callback then options.callback(value) end
            end,
        })
        local object = SHControlObject(control, self.bridge.i18n, options.key, SHWidgetScope(), options)
        local baseSet, baseGet, baseRefresh = control.Set, control.Get, control.Refresh
        object.Set = function(self, value, silent)
            local label = labelByValue[value] or value
            baseSet(control, label, silent)
        end
        object.Get = function()
            local label = baseGet(control)
            return valueByLabel[label] or label
        end
        object.SetValue = object.Set
        object.GetValue = object.Get
        object.SetItems = function(self, newItems)
            values, valueByLabel, labelByValue = SHMapItems(newItems, bridge.i18n)
            baseRefresh(control, values)
        end
        object.Refresh = object.SetItems
        return object
    end

    function component:Input(options)
        options = options or {}
        local section = getDefaultSection(self)
        local control = section:AddTextbox({
            Title = SHTranslate(self.bridge.i18n, options.key or options.title or options.Title, options.parameters),
            Description = options.description and SHTranslate(self.bridge.i18n, options.description, options.parameters) or "",
            Placeholder = SHTranslate(self.bridge.i18n, options.placeholderKey or options.placeholder or "ui.typeHere", options.parameters),
            Default = tostring(options.value or options.default or ""),
            Finished = true,
            Callback = function(value)
                if options.onChanged then options.onChanged(value) elseif options.callback then options.callback(value) end
            end,
        })
        local object = SHControlObject(control, self.bridge.i18n, options.key, SHWidgetScope(), options)
        object.SetText = object.Set
        return object
    end

    function component:Slider(options)
        options = options or {}
        local section = getDefaultSection(self)
        local control = section:AddSlider({
            Title = SHTranslate(self.bridge.i18n, options.key or options.title or options.Title, options.parameters),
            Description = options.description and SHTranslate(self.bridge.i18n, options.description, options.parameters) or "",
            Min = tonumber(options.min or options.Min) or 0,
            Max = tonumber(options.max or options.Max) or 100,
            Increment = tonumber(options.increment or options.step) or 1,
            Default = tonumber(options.value or options.default) or 0,
            Suffix = options.suffix or "",
            Callback = options.onChanged or options.callback,
        })
        return SHControlObject(control, self.bridge.i18n, options.key, SHWidgetScope(), options)
    end

    function component:Banner(options)
        options = options or {}
        local parent = self.root or self.parent or (self.tab and self.tab._page)
        local frame = Instance.new("Frame")
        frame.Name = "SaintHubBanner"
        frame.Size = UDim2.new(1, 0, 0, 86)
        frame.BackgroundColor3 = NextUI.Theme.Card or NextUI.Theme.Element
        frame.BorderSizePixel = 0
