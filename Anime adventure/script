		titleLabel.Visible = t ~= nil and t ~= false and t ~= ""
	end
	function wm:SetIcon(src) setIcon(src) end
	function wm:SetPosition(corner) placeWatermark(root, corner, margin) end
	function wm:SetVisible(v)
