		if NextUI.Watermark == wm then NextUI.Watermark = nil end
	end

	local builtin = { FPS = wm.AddFPS, Ping = wm.AddPing, Time = wm.AddTime, Player = wm.AddPlayer }
	for _, e in ipairs(o.Items or { "FPS", "Ping" }) do
