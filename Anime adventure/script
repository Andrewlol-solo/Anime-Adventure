-- Persistent user configuration. Executor file APIs are optional; the controller
-- still works without them, but settings then live only for the current session.
local SETTINGS_DIR = "AAInfinity"
local SETTINGS_FILE = SETTINGS_DIR .. "/settings.json"
local function loadPersistentSettings()
    if type(readfile) ~= "function" or type(isfile) ~= "function" then return {} end
    local ok, raw = pcall(function()
        if not isfile(SETTINGS_FILE) then return nil end
        return readfile(SETTINGS_FILE)
    end)
    if not ok or type(raw) ~= "string" or raw == "" then return {} end
    local decodedOk, decoded = pcall(function() return HttpService:JSONDecode(raw) end)
    if decodedOk and type(decoded) == "table" then return decoded end
    return {}
end
