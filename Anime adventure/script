			wm:Add(e.Name or e.Title, e.Value)
		end
	end

	task.spawn(function()
		while not wm._dead do
			for _, it in ipairs(items) do it._refresh() end
			task.wait(interval)
		end
	end)

	self.Watermark = wm
	return wm
end

function NextUI:CreateKeybindList(o)
	if type(o) ~= "table" then o = {} end
